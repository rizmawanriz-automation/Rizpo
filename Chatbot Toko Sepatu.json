    {
      "parameters": {
        "jsCode": "// Ambil output teks dari node AI Agent sebelumnya\nconst rawOutput = $json.output || \"\";\n\n// Separator yang digunakan untuk memisah teks dan URL\nconst SEPARATOR = '|';\n\nlet text = rawOutput.trim();\nlet url = \"none\";\n\n// Cek apakah ada karakter separator '|' di dalam output AI\nif (text.includes(SEPARATOR)) {\n  const parts = text.split(SEPARATOR);\n  \n  // Ambil elemen terakhir sebagai URL candidate\n  const potentialUrl = parts.pop().trim();\n  \n  // Sisa elemen digabungkan kembali menjadi pesan teks untuk customer\n  text = parts.join(SEPARATOR).trim();\n\n  // Validasi URL: Hanya anggap sebagai URL jika berawalan http/https dan bukan kata \"none\"\n  if (potentialUrl.toLowerCase() !== \"none\" && /^https?:\\/\\//i.test(potentialUrl)) {\n    url = potentialUrl;\n  }\n}\n\n// Bersihkan karakter markdown bold/italic liar di ujung teks jika ada\ntext = text.replace(/[\\*\\_\\~]+$/, '').trim();\n\n// Output JSON yang bersih untuk node berikutnya (WAHA / IF Node)\nreturn {\n  text: text,\n  url: url\n};"
      },
